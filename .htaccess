# Marcas al Grano — reglas del servidor (Apache / Hostinger)

# Unifica el dominio: www.somosmarcasalgrano.com redirige a la versión sin
# www, que es la que declaran las etiquetas canonical del index.html.
# Sin esto la misma landing queda accesible en dos direcciones distintas.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Cache de imágenes y del PDF: no cambian casi nunca y pesan lo que más.
# El index.html queda fuera a propósito, para que cada despliegue se vea
# de inmediato y no quede servido desde la caché del visitante.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 1 month"
  ExpiresByType image/png       "access plus 1 month"
  ExpiresByType image/webp      "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>
